  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wasabiprivaterelay/szamlazo.git",
    "directory": "packages/nav"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
