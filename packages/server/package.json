{
  "name": "@szamlazo/server",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted invoicing server: issues invoices, reports them to NAV, emails, archives and reconciles",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build": "rm -rf dist && esbuild src/index.ts src/cli.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outdir=dist --sourcemap --log-level=warning",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@szamlazo/invoicing": "0.1.0",
    "@szamlazo/nav": "0.1.0",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "hono": "^4.13.16",
    "pino": "^10.4.0",
    "postgres": "^4.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
