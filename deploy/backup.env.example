# For deploy/bin/backup. Copy to deploy/backup.env and chmod 600.
# docs/production.md, step 9, says where each value comes from.

# R2 → Manage R2 API tokens → Create: "Object Read & Write", limited to the
# backup bucket only. The endpoint is https://<account id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=szamlazo-backups

# A separate Healthchecks.io check for the backup (period 1 day, grace 2 hours).
# Not the same URL as the server's HEALTHCHECK_URL.
BACKUP_HEALTHCHECK_URL=
