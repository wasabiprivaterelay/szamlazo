# For Docker Compose itself, not for the server. Copy to deploy/.env:
#   cp .env.example .env && chmod 600 .env
# The server's own settings go in deploy/szamlazo.env (from ../.env.example).

# The database password. Generate it on the server, never reuse one:
#   openssl rand -hex 32
# Hex only, so it can sit inside DATABASE_URL without escaping.
POSTGRES_PASSWORD=

# "tunnel" starts cloudflared next to the server (docs/production.md, step 6).
# Leave empty to run without it, for example while testing on the server.
COMPOSE_PROFILES=tunnel

# The tunnel's token from the Cloudflare dashboard (Zero Trust → Networks →
# Tunnels → your tunnel → the long string after "--token"). It can run this
# one tunnel and nothing else.
TUNNEL_TOKEN=

# The port on 127.0.0.1 the server is published on, for curl on the server.
SERVER_PORT=3000
