# szamlazo configuration
#
# Every setting the server reads, with where its value comes from.
#   Development:  cp .env.example .env          (repository root)
#   Production:   cp .env.example deploy/szamlazo.env   (docs/production.md)
#
# The server checks all of this at start-up and refuses to run, naming every
# problem, rather than failing on the first invoice. `npm run szamlazo -- doctor`
# checks the parts that need a network: database, storage, NAV, email.
#
# Required lines are uncommented. Everything commented out is optional and
# shows its default.

# ─── Installation ────────────────────────────────────────────────────────────

# development | staging | production
# Only "production" may report to NAV's live system, and "production" must.
# Anything else puts [TESZT] in every email subject.
ENVIRONMENT=development

# Postgres 15 or newer. This matches the database from `docker compose up -d`.
# In production deploy/compose.yml sets it for you; leave it out of szamlazo.env.
DATABASE_URL=postgres://szamlazo:szamlazo@127.0.0.1:5432/szamlazo

# Where the HTTP API listens. 127.0.0.1 keeps it on this machine; the Docker
# image sets 0.0.0.0 inside the container.
# HOST=127.0.0.1
# PORT=3000

# fatal | error | warn | info | debug | trace. Logs are JSON on stdout; secrets
# are redacted and buyers' details are not logged.
# LOG_LEVEL=info

# API keys allowed to call /v1, as name:sha256, comma separated. Never the key
# itself. Make one with:
#   npm run szamlazo -- api-key new webshop
# It prints the key once (give it to the client) and the line to paste here.
# The name shows in the audit log as who issued each invoice.
API_KEYS=

# Behind a proxy, the header holding the client's real address, used for rate
# limiting. Behind a Cloudflare Tunnel: CF-Connecting-IP. Leave empty when
# clients connect directly; a header a client can set itself is no limit.
# CLIENT_IP_HEADER=

# ─── The seller: you, as printed on every invoice ────────────────────────────

# Exactly as registered (cégnév / egyéni vállalkozó neve).
SELLER_NAME=Minta Kft.
SELLER_POSTCODE=1011
SELLER_CITY=Budapest
SELLER_ADDRESS=Fő utca 1.
# The full 11-digit Hungarian tax number, dashes optional: 12345678-2-41.
# Its first eight digits must match NAV_TAX_NUMBER.
SELLER_TAX_NUMBER=12345678-2-41

# Cégjegyzékszám for a company, nyilvántartási szám for a sole trader.
# SELLER_REGISTRATION_NUMBER=01-09-123456
# Printed for transfer payments, and in the invoice email.
# SELLER_BANK_ACCOUNT=11773016-11111111-00000000
# SELLER_BANK_NAME=OTP Bank
# SELLER_EMAIL=szamla@example.hu
# SELLER_PHONE=+36 1 234 5678

# true if you are alanyi adómentes (AAM): no invoice carries VAT, every line
# is sent with vatRate 0 and printed and reported as AAM. docs/api.md,
# "Lines without VAT".
# SELLER_AAM=false

# ─── Invoices ────────────────────────────────────────────────────────────────

# Numbers look like SZ2026/00001: these letters, the year, a counter that never
# skips and never repeats. One to eight capital letters. Choose before the
# first real invoice and do not change it afterwards.
# INVOICE_PREFIX=SZ

# Due date = issue date + this many days, unless a request gives dueDate.
# PAYMENT_TERM_DAYS=8

# A PNG or JPEG under 1 MB, printed top left. In Docker: put it in
# deploy/branding/ and use /app/branding/logo.png.
# INVOICE_LOGO_PATH=
# INVOICE_ACCENT_COLOUR=#1d4f86
# Small print at the bottom of every PDF.
# INVOICE_FOOTER=

# ─── NAV Online Számla ───────────────────────────────────────────────────────
# Without these five the server still issues invoices but does not report
# them, which is only acceptable while developing. docs/nav-test-environment.md
# shows how to get them for NAV's test system; production needs a separate
# technical user created on the live system.

# test | production. Must be "production" when ENVIRONMENT=production, and must
# not be anywhere else.
NAV_ENVIRONMENT=test
# The technical user's login name (6-15 letters and digits).
NAV_LOGIN=
NAV_PASSWORD=
# "XML aláírókulcs" on the portal.
NAV_SIGNING_KEY=
# "XML cserekulcs": exactly 16 characters.
NAV_EXCHANGE_KEY=
# The taxpayer the technical user belongs to: 8 digits, or the full number.
NAV_TAX_NUMBER=

# How this program introduces itself to NAV on every request. The name and
# contact are the developer's: whoever runs and maintains this installation.
NAV_SOFTWARE_DEV_NAME=
# An email address NAV can write to about the software.
NAV_SOFTWARE_DEV_CONTACT=
# 18 characters of A-Z, 0-9 and -. The default is your 8-digit tax number
# followed by SZAMLAZO-1, which is unique to your installation.
# NAV_SOFTWARE_ID=
# NAV_SOFTWARE_NAME=szamlazo
# ONLINE_SERVICE (a server) or LOCAL_SOFTWARE.
# NAV_SOFTWARE_OPERATION=ONLINE_SERVICE
# NAV_SOFTWARE_VERSION=0.1.0
# NAV_SOFTWARE_DEV_TAX_NUMBER=

# ─── Where the PDFs are kept ─────────────────────────────────────────────────
# The PDF is the invoice; it is kept for at least eight years and its SHA-256
# is stored, so any change to it is noticed.

# local: a folder on this machine (back it up: deploy/bin/backup does).
# s3: any S3-compatible bucket; Cloudflare R2 is what docs/production.md uses.
# STORAGE=local
# Relative paths are relative to where the server is started (the repository
# root for `npm run dev`). Docker sets /data/invoices.
# STORAGE_DIR=./data/invoices

# For STORAGE=s3. R2: https://<account id>.r2.cloudflarestorage.com, with a
# token limited to this one bucket ("Object Read & Write").
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto

# ─── Email (Brevo) ───────────────────────────────────────────────────────────
# Sends the invoice to the buyer once NAV has accepted it, alerts to you, and
# the monthly archive. Without it nothing is emailed; the API still works.

# Brevo → SMTP & API → API keys. Not the SMTP password.
# BREVO_API_KEY=
# A sender address verified in Brevo, on a domain with SPF and DKIM set up.
# EMAIL_FROM=szamla@example.hu
# EMAIL_FROM_NAME=Minta Kft.
# EMAIL_REPLY_TO=info@example.hu

# Who hears about problems: NAV rejections, invoices stuck for an hour,
# emails that bounce, PDFs that changed, NAV records that do not match ours.
# ALERT_EMAIL=you@example.hu

# Where every month's invoices (PDFs plus NAV XML, zipped) are sent on the 1st.
# Often the accountant, or a mailbox kept just for this.
# INVOICE_ARCHIVE_EMAIL=

# ─── The checker ─────────────────────────────────────────────────────────────
# Runs inside the server: reports to NAV, follows up, emails, retries, raises
# and resolves alerts, compares with NAV nightly, sends the monthly archive.

# A Healthchecks.io ping URL. Pinged after every pass; when the pings stop,
# Healthchecks emails you. Set the check's period to 5 minutes, grace 30.
# HEALTHCHECK_URL=https://hc-ping.com/<uuid>
# CHECKER_ENABLED=true
# CHECKER_INTERVAL_SECONDS=300

# ─── Tests only ──────────────────────────────────────────────────────────────
# `npm test` uses its own database, created by `docker compose up -d`, and
# empties it on every run. Never point this at real data.
# TEST_DATABASE_URL=postgres://szamlazo:szamlazo@127.0.0.1:5432/szamlazo_test
